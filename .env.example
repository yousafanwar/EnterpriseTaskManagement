MSSQL_SA_PASSWORD=sql-server-db-password
JWT_KEY=jwt-secret
# Set to true to enable AI task analysis (requires AI_* and CLOUDINARY_* below).
AI_ENABLED=false
AI_PROVIDER=Gemini
AI_API_KEY=your-gemini-api-key
AI_MODEL=your-selected-gemini-model
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret