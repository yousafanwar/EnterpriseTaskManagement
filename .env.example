MSSQL_SA_PASSWORD=sql-server-db-password
JWT_KEY=jwt-secret
# Set to true to enable AI task analysis (requires AI_* and CLOUDINARY_* below).
AI_ENABLED=false
AI_PROVIDER=Gemini
AI_API_KEY=your-gemini-api-key
AI_MODEL=your-selected-gemini-model
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# WhatsApp Cloud API (requires AI_ENABLED=true). Callback URL:
#   https://<your-public-host>/api/integrations/whatsapp/webhook
# Flow: user picks a project from a list, then sends description + optional image in one message.
# Register the business phone_number_id via POST /api/whatsapp/contacts (ProjectId is admin reference only).
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-access-token
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_SEND_REPLIES=true